# ── Required ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONARCH_MASTER_KEY=
SESSION_SECRET=

ADMIN_USERNAME=monarch
ADMIN_PASSWORD=monarch

# Local dev: ./data/monarch.db   ·   Render: /data/monarch.db
DATABASE_PATH=./data/monarch.db

# ── Optional: pre-seed MCP credentials ────────────────────────
# These are picked up by scripts/seed.ts on first start.
# You can also leave them blank and paste through the UI later.

# LinkedIn Marketing API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202604

# Meta Marketing API
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Google (shared OAuth across Ads / GA4 / Search Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v22

# Advanced Web Ranking (one or two accounts)
AWR_1ST_API_TOKEN=
AWR_API_TOKEN=

# DataForSEO (Keyword Volume)
DATAFORSEO_AUTH_BASE64=
DATAFORSEO_DEFAULT_LOCATION_NAME=Kolkata,Kolkata,West Bengal,India
DATAFORSEO_DEFAULT_LANGUAGE_CODE=en

# AI providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# Storage
BLOB_READ_WRITE_TOKEN=

# Comms / Productivity / CRM / Email / Payments / Dev
SLACK_BOT_TOKEN=
NOTION_API_TOKEN=
AIRTABLE_API_TOKEN=
GITHUB_TOKEN=
HUBSPOT_API_TOKEN=
MAILCHIMP_API_KEY=
SENDGRID_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
